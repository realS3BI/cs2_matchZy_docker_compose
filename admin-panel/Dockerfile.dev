# Development image for API and demo worker: system tools and dependencies only.
# docker-compose.dev.yml mounts the source; tsc --watch and node --watch restart the process.
FROM node:22-alpine

RUN apk add --no-cache ffmpeg bzip2
RUN corepack enable pnpm
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
