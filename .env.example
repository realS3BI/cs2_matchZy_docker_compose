# ------------------------------
# CS2 server
# ------------------------------
SRCDS_TOKEN=
CS2_SERVERNAME="CS2 MatchZy Server"
CS2_RCONPW=
CS2_PW=
CS2_MAXPLAYERS=10
CS2_STARTMAP=de_mirage
CS2_PORT=27015
TV_PORT=27020
CS2_ADDITIONAL_ARGS=

# ------------------------------
# Mod installer
# ------------------------------
# Exactly one server mode: matchzy, executes, or vanilla.
SERVER_MODE=matchzy
METAMOD_VERSION=latest
# Derived from SERVER_MODE; kept for migration compatibility.
MATCHZY_ENABLED=1
MATCHZY_VERSION=latest
COUNTERSTRIKESHARP_VERSION=latest
FAKE_RCON_ENABLED=0
FAKE_RCON_VERSION=latest
WEAPONPAINTS_ENABLED=0
WEAPONPAINTS_VERSION=latest
FORTNITE_EMOTES_ENABLED=0
FORTNITE_EMOTES_VERSION=latest
FORTNITE_EMOTES_WORKSHOP_ADDON_ID=3328582199
MULTIADDONMANAGER_VERSION=latest
RAYTRACE_VERSION=latest
# Set to 0 to keep CS2_WORKSHOP_MAPS saved but prevent loading/mounting them.
CS2_WORKSHOP_MAPS_ENABLED=0
# Comma-separated Steam Workshop map links or IDs.
# Examples:
# CS2_WORKSHOP_MAPS=https://steamcommunity.com/sharedfiles/filedetails/?id=3070244462, https://steamcommunity.com/sharedfiles/filedetails/?id=3077265396
# CS2_WORKSHOP_MAPS=3070244462,3077265396
CS2_WORKSHOP_MAPS=
# Force MultiAddonManager to check/download mounted workshop addons on every map load.
CS2_WORKSHOP_FORCE_DOWNLOAD=0
# Derived from SERVER_MODE by the panel/bootstrap. Kept for migration compatibility.
EXECUTES_ENABLED=0
EXECUTES_VERSION=latest
SIMPLEADMIN_ENABLED=0
SIMPLEADMIN_VERSION=latest
PLAYERSETTINGS_VERSION=latest
ANYBASELIB_VERSION=latest
MENUMANAGER_VERSION=latest
MATCHZY_SMOKE_COLOR=0
# Store .savenade entries under MatchZy's global "default" nade library.
MATCHZY_SAVE_NADES_AS_GLOBAL=1
# Optional MatchZy chat prefix override.
# Must use MatchZy color syntax, for example [{Green}MatchZy{Default}].
# Leave empty to use [{Green}MatchZy{Default}].
MATCHZY_CHAT_PREFIX=
# Legacy migration only. The panel imports valid Steam64IDs as Owner roles once.
# Comma-separated Steam64IDs, spaces around commas are allowed.
# Example: ADMINS=76561198000000001, 76561198000000002
ADMINS=
MOD_REINSTALL=0

# Daily uptime refresh controlled by the admin panel.
AUTO_RESTART_ENABLED=1
AUTO_RESTART_TIME=05:00
AUTO_RESTART_TIMEZONE=Europe/Vienna

# ------------------------------
# Admin panel
# ------------------------------
COMPOSE_PROJECT_NAME=cs2-matchzy
ADMIN_PANEL_PASSWORD=
ADMIN_PANEL_SESSION_SECRET=
ADMIN_PANEL_PORT=8080
ADMIN_PANEL_CONTROL_MODE=docker
ADMIN_PANEL_CS2_CONTAINER=
MONGODB_URI=mongodb://mongodb:27017/cs2_admin_panel
MONGODB_DB=cs2_admin_panel
# Live bidirectional sync between MongoDB nades and MatchZy's savednades.json.
ADMIN_PANEL_NADES_SYNC_ENABLED=1
ADMIN_PANEL_NADES_SYNC_INTERVAL_MS=2000
ADMIN_PANEL_LIVE_MATCHZY_NADES_FILE=/cs2-data/game/csgo/cfg/MatchZy/savednades.json
# Optional: required only for lineup image uploads in the Nades dialog.
UPLOADTHING_TOKEN=

# ------------------------------
# Host ports (fixed in docker-compose.yml)
# 27015: CS2 game (tcp/udp)
# 27020: CS TV (udp, reserved)
# ------------------------------
