# Öffentliche Adresse ohne Pfad, z. B. https://cs2.example.com
ADMIN_PANEL_PUBLIC_URL=
# Erste Admin-Steam64-ID. Vorhandene Owner werden automatisch übernommen.
ADMIN_PANEL_ADMIN_STEAM_ID=
ADMIN_PANEL_SESSION_SECRET=
# Optionaler Spieler-Testzugang unter /login/test. Ohne Passwort deaktiviert.
ADMIN_PANEL_TEST_USERNAME=test
ADMIN_PANEL_TEST_PASSWORD=
# Token der UploadThing-App für Review-Fotos und -Videos. Nur serverseitig verwenden.
UPLOADTHING_TOKEN=

# Analyse: Originaldemos und Replay-Daten im privaten Demo-Volume.
ANALYSIS_STORAGE_LIMIT_GIB=100
ANALYSIS_SCOPE_LIMIT_GIB=20
ANALYSIS_MINIMUM_FREE_GIB=2
# Tonaufnahmen: local oder uploadthing (UploadThing-App muss private ACL erlauben).
RECORDING_STORAGE=local
# FACEIT: Data-API-Schlüssel und separat freigegebener Downloads-Zugang.
FACEIT_API_KEY=
FACEIT_DOWNLOADS_TOKEN=
# Valve Match History und optionale separate Steam-Client-Sitzung für Demoauflösung.
STEAM_WEB_API_KEY=
STEAM_GC_REFRESH_TOKEN=
