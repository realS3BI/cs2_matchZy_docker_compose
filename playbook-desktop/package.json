{
  "name": "playbook-desktop",
  "productName": "Playbook",
  "version": "0.1.10",
  "description": "Playbook mit automatischer CS2-Review-Aufnahme für Windows",
  "author": "Sebastian Schlosser",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:cs2": "node test/live-cs2.js --offline",
    "test:desktop": "node test/live-desktop.js",
    "test:archives": "dotnet run --project test/archives/ArchiveTests.csproj --configuration Release",
    "build:native": "npm run test:archives && dotnet publish native/Playbook.Windows.csproj -c Release -r win-x64 --self-contained true -o native/bin/publish",
    "build:app": "npm run test && npm run build:native && electron-builder --win --dir --x64 --publish never",
    "dist": "npm run test && npm run build:native && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "at.schlossers.playbook",
    "artifactName": "Playbook-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin/publish/Playbook.Windows.exe",
        "to": "Playbook.Windows.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "realS3BI",
        "repo": "playbook",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/realS3BI/playbook.git",
    "directory": "playbook-desktop"
  },
  "homepage": "https://github.com/realS3BI/playbook#readme",
  "bugs": {
    "url": "https://github.com/realS3BI/playbook/issues"
  }
}
